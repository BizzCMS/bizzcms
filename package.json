{
  "name": "bizzcms",
  "version": "0.2.3",
  "private": true,
  "description": "Free, open-source headless CMS for business websites. Serverless on Cloudflare Workers, D1 and R2.",
  "homepage": "https://bizzcms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BizzCMS/bizzcms.git"
  },
  "bugs": {
    "url": "https://github.com/BizzCMS/bizzcms/issues"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "type-check": "tsc --noEmit",
    "release:patch": "npm version patch -m \"Release %s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Release %s\" && git push --follow-tags"
  },
  "dependencies": {
    "@sonicjs-cms/core": "3.0.0-beta.28"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.52.1"
  },
  "overrides": {
    "better-auth": "1.6.23",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@better-auth/telemetry": "1.6.23",
    "drizzle-orm": "0.45.2",
    "csv-parse": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
